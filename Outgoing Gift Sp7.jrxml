						height="242"
						key="textField-4"/>
					<box></box>
					<textElement markup="html">
						<font/>
					</textElement>
				<textFieldExpression   class="java.lang.String"><![CDATA["<b>Material enclosed</b>"+
"<br/>"+
"<br/>"+
"<b>RBGE gift num.: </b>"+$F{40.exchangeout.exchangeOutNumber}+"<i>  (please use in all correspondence regarding this material)</i>"+
"<br/>"+
"<br/>"+
"<b>Description: </b>"+$F{40,141-exchangeOutPreps.exchangeoutprep.quantity}+" specimens returned of "+$F{40.exchangeout.contents}+
"<br/>"+
"<br/>"+
"<b>Restrictions of use <b/>(any restrictions arising from CBD or Nagoya benefit sharing agreement)"+
"<br/>"+
"<br/>"+
"Please can you sign and return one copy to acknowledge as received safely."+
"<br/>"+
"<b>You can scan and email the document to herbarium@rbge.org.uk<b/>"]]></textFieldExpression>
				</textField>
